plugins {
    id 'com.android.application'
}

android {
    namespace '{{package}}'
    compileSdk 34

    defaultConfig {
        applicationId '{{package}}'
        minSdk {{min_sdk}}
        targetSdk 34
        versionCode 1
        versionName "1.0"

        // Odin native engine – start with arm64 only (WayDirect pattern)
        ndk {
            abiFilters 'arm64-v8a'
        }

        externalNativeBuild {
            // Placeholder: point at a CMake/ndk-build that links the Odin .so
            // cmake { path "src/main/cpp/CMakeLists.txt" }
        }
    }

    buildTypes {
        release {
            minifyEnabled false
            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
        }
        debug {
            jniDebuggable true
        }
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }

    sourceSets {
        main {
            // asstudio emits flat java/ and res/ under the generate root;
            // map them into a normal Android app layout when scaffolding a project.
            java.srcDirs = ['src/main/java']
            res.srcDirs = ['src/main/res']
            manifest.srcFile 'src/main/AndroidManifest.xml'
            jniLibs.srcDirs = ['src/main/jniLibs']
        }
    }
}

dependencies {
    implementation 'androidx.appcompat:appcompat:1.6.1'
    implementation 'com.google.android.material:material:1.11.0'
    implementation 'androidx.constraintlayout:constraintlayout:2.1.4'
}
