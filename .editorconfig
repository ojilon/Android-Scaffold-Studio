# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{h,hpp,cpp,c,cc}]
indent_size = 4
max_line_length = 100

[*.{json,yml,yaml}]
indent_size = 2

[CMakeLists.txt]
indent_size = 4

[*.cmake]
indent_size = 4

[*.md]
# Markdown keeps hard-wrapped paragraphs readable; trailing spaces are still
# stripped because they are invisible.
trim_trailing_whitespace = true

# Generated output and reviewed-by-hand golden files: preserve exactly.
[docs/golden/**]
trim_trailing_whitespace = false

[templates/**]
trim_trailing_whitespace = false
